/build/reports/detekt/
/build/reports/ktlint/

# Gradle wrapper binary IS committed (needed to bootstrap the build without a local Gradle install)
# !gradle/wrapper/gradle-wrapper.jar

# Node.js (commitlint tooling, see scripts/status-checks/)
node_modules/
