<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions required by Sift's call-screening logic.
        READ_CONTACTS is needed to check whether an incoming number is in the user's address book
        (the core "never block a known contact" rule, PROJECT_CONTEXT.md §7).
        POST_NOTIFICATIONS is required on API 33+ to show blocked-call notifications.
        ANSWER_PHONE_CALLS is declared for the CallScreeningService role (F1).
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:maxSdkVersion="32" />

    <application
        android:name=".SiftApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sift">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            IncomingCallScreeningService is declared here as a placeholder.
            Full implementation (F1) requires the BIND_SCREENING_SERVICE permission
            and a role request for ROLE_CALL_SCREENING via RoleManager.
        -->

    </application>

</manifest>
