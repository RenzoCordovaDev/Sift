<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions required by Sift's call-screening logic.
        READ_CONTACTS is needed to check whether an incoming number is in the user's address book
        (the core "never block a known contact" rule, PROJECT_CONTEXT.md §7).
        POST_NOTIFICATIONS is required on API 33+ to show blocked-call notifications.
        ANSWER_PHONE_CALLS is declared for the CallScreeningService role (F1).
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SiftApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sift">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            IncomingCallScreeningService is the Android entry point for call screening.
            android:permission restricts binding to callers that hold BIND_SCREENING_SERVICE,
            which only the system telecom process holds. android:exported="true" is required
            so the system can bind to the service; the permission requirement prevents
            arbitrary apps from doing so.
            The user must also grant the app ROLE_CALL_SCREENING via RoleManager (F5).
        -->
        <service
            android:name=".data.service.IncomingCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
